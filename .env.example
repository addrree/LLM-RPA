# Default backend for local runs
LLM_BACKEND=ollama

# Ollama API URL:
# - local backend: http://localhost:11434
# - cloud backend: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Required for backend=ollama_cloud (Bearer token)
OLLAMA_API_KEY=

# Default model for planner + verifier (vision capable)
OLLAMA_MODEL=qwen3-vl:4b

# Optional per-role overrides
OLLAMA_PLANNER_MODEL=qwen3-vl:4b
OLLAMA_VERIFIER_MODEL=qwen3-vl:4b

# Request timeout for Ollama API calls (seconds)
OLLAMA_TIMEOUT_SEC=300
